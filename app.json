{
  "expo": {
    "name": "Music",
    "slug": "my-music-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tejvirmann.mymusic",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Connect to your Jellyfin server on your home network."
      }
    },
    "android": {
      "package": "com.tejvirmann.mymusic",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-image",
      "expo-font",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Tiger",
            "ios": "./assets/icons/tiger.png",
            "android": {
              "foregroundImage": "./assets/icons/tiger.png",
              "backgroundColor": "#000000"
            }
          }
        ]
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a cover image for your playlists."
        }
      ]
    ]
  }
}
